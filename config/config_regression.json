    "conv_kernel_text": 5,
    "conv_kernel_audio": 5,
    "conv_kernel_visual": 5,
    "dropout_text": 0.5,
    "dropout_audio": 0.2,
    "dropout_visual": 0.0,
    "dropout_output": 0.5,
    "dropout_cam_attention": 0.0,
    "router_hidden_dim": 256,
    "tau_min": 0.1,
    "tau_max": 10.0,
    "gamma": 0.1,
    "lambda_att_ent": 0.01,
    "lambda_atr": 0.1,
    "lambda_cam": 0.1,
    "eps": 1e-08
